# Copie para .env e preencha (o .env NUNCA deve ser commitado)
OBA_USER=
OBA_PASSWORD=
WILBOOR_USER=
WILBOOR_PASSWORD=

# true = apenas mostra o que faria, sem clicar em Pausar/Publicar
DRY_RUN=false
# true = abre o navegador visível (útil para acompanhar/depurar no computador)
HEADFUL=false

# Sessão do obaobamix: por padrão é lida de oba-session.json (gerado por "npm run salvar-sessao")
# OBA_SESSION_FILE=oba-session.json
